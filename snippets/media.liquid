{%- comment -%}
  Optimized product media snippet for IndyVogue.
  Enhancements:
  - First image loads eagerly
  - Others lazy load
  - Width/height attributes for CLS
  - Silk Mark logo overlay retained
{%- endcomment -%}

{%- liquid
  unless lazy_load == false
    assign lazy = 'lazy'
  endunless
  assign image = media.preview_image
  assign media_group = group_media_obj | where: "mid", media.id | first
  assign media_hidden = ''
  if media_group.size > 0
    if un_no_pick
      assign media_hidden = 'hidden'
    endif
    assign media_option_name = 'option' | append: media_group.option
    assign media_option_value = product.options_with_values[media_group.option].values[media_group.value]
    assign current_value = selected_variant.options[media_group.option]
    if current_value == media_option_value and current_value != blank
      assign media_hidden = ''
    endif
  else
    assign media_option_name = ''
    assign media_option_value = ''
  endif
-%}

{%- comment -%} Eager load the first image only {%- endcomment -%}
{% if is_first %}
  {% assign load_attr = 'eager' %}
{% else %}
  {% assign load_attr = 'lazy' %}
{% endif %}

{%- comment -%} Silk Mark Badge {%- endcomment -%}
{% assign fabric_value = product.metafields.saree.fabric_type | metafield_text %}
{% if product.type == 'Saree' and fabric_value contains 'Silk Mark Certified' %}
  <div class="ivy-badge-logo-left">
    <img src="https://cdn.shopify.com/s/files/1/1469/7362/files/Silk-Mark-Product.jpg?v=1753640761" alt="Silk Mark Certified" width="80" height="80">
  </div>
{% endif %}

{%- if media.media_type == 'image' -%}
  <div {{ media_hidden }}{% if variant_images contains media.src %} data-variants-id="{{ product.images | where: 'src', image.src | map: 'variants' | map: 'id' | join: ';' }}"{% endif %} class="{{ class }} hdt-product__media-item" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type }}" data-group-name="{{ media_option_name }}"  data-group-value="{{ media_option_value | escape }}">
    <div class="hdt-ratio hdt-product__media" style="--aspect-ratioapt:{{ image.aspect_ratio }}; --mw-media:{{ image.width }}px">
      {{ image | image_url: width: 823 | image_tag:
        loading: load_attr,
        widths: '493, 600, 713, 823',
        width: image.width,
        height: image.height,
        sizes: sizes }}
    </div>
  </div>

{%- else -%}
  <div {{ media_hidden }} class="{{ class }} hdt-product__media-item" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type }}" data-vhost="{{ media.host }}" data-group-name="{{ media_option_name }}" data-group-value="{{ media_option_value | escape }}">
    <div class="hdt-ratio hdt-product__media" style="--aspect-ratioapt:{{ media.aspect_ratio | default: 1 }}; --mw-media:100%">
      {%- case media.media_type -%}
        {%- when 'video' -%}
          <hdt-video-player type="video">
            {{ image | image_url: width: 823 | image_tag:
              loading: 'lazy',
              widths: '493, 600, 713, 823',
              width: image.width,
              height: image.height }}
            {{ media | video_tag: image_size: '400x', playsinline: true, autoplay: autoplay, muted: mute, loop: loop, controls: true, preload: 'none' }}
          </hdt-video-player>

        {%- when 'external_video' -%}
          <hdt-video-player type="external_video" host="{{ media.host }}">
            {{ image | image_url: width: 823 | image_tag:
              loading: 'lazy',
              widths: '493, 600, 713, 823',
              width: image.width,
              height: image.height }}
            <template>
              {%- if media.host == 'youtube' -%}
                {{ media | external_video_url: autoplay: autoplay, loop: loop, mute: mute, playlist: media.external_id | external_video_tag }}
              {%- else -%}
                {{ media | external_video_url: autoplay: autoplay, loop: loop, mute: mute | external_video_tag }}
              {%- endif -%}
            </template>
          </hdt-video-player>

        {%- when 'model' -%}
          <hdt-model-player section-id="{{ section.id }}">
            {{ media | media_tag: image_size: '823x', reveal: 'interaction', toggleable: true, data-model-id: media.id }}
          </hdt-model-player>
      {%- endcase -%}
    </div>

    {%- if media.media_type == 'model' -%}
      <button type="button" class="hdt-btn hdt-w-full hdt-flex hdt-justify-center product__xr-button" aria-label="{{ 'products.product.xr_button_label' | t }}" data-shopify-xr data-shopify-model3d-id="{{ media.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden>
        {% render 'icon' with '3d-model' %}
        {{ 'products.product.xr_button' | t }}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}
